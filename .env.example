# ─── Database ─────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/qa_assistant?schema=public"

# ─── NextAuth ─────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_SECRET="same-as-nextauth-secret"

# ─── Bitbucket OAuth ─────────────────────────────
# Bitbucket > Workspace Settings > OAuth Consumers > Add Consumer
# Callback URL: http://localhost:3000/api/auth/callback/bitbucket
# Permissions: Account (Read), Repositories (Read), Pull Requests (Read)
AUTH_BITBUCKET_ID=""
AUTH_BITBUCKET_SECRET=""

# ─── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=""
# Higher quality default for final answers. Override if your account uses a different model.
OPENAI_MODEL="gpt-4.1"
# Smaller/cheaper model for selecting relevant repo files before the final answer.
OPENAI_FILE_SELECTOR_MODEL="gpt-4.1-mini"
# Max indexed repo context characters sent to the model per answer.
AI_CONTEXT_CHARS="90000"

# ─── GitHub (optional, increases rate limit from 60 to 5000 req/hour) ──
GITHUB_TOKEN=""
