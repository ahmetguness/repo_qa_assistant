# OpenAI API Key (zorunlu)
OPENAI_API_KEY=sk-...

# GitHub Personal Access Token (opsiyonel)
# Private repolar ve yüksek API limiti (5000 istek/saat) için
GITHUB_TOKEN=ghp_...

# Bitbucket Cloud credentials (opsiyonel)
# Private repolar için. App password: Bitbucket > Settings > App passwords
BB_USERNAME=
BB_APP_PASSWORD=

# Bitbucket OAuth 2.0 (opsiyonel — kullanıcı giriş sistemi için)
# Bitbucket > Workspace settings > OAuth consumers > Add consumer
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_REDIRECT_URI=http://localhost:8501

# Repo cache dizini (opsiyonel, varsayılan: .repo_cache)
# REPO_CACHE_DIR=.repo_cache
