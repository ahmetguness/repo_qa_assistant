generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Tables ────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  chatSessions  ChatSession[]
  chatFolders   ChatFolder[]
  workspaces    UserWorkspace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Bitbucket Workspace & Repos ────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  avatarUrl String?

  repositories Repository[]
  users        UserWorkspace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model UserWorkspace {
  id          String @id @default(cuid())
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("user_workspaces")
}

model Repository {
  id          String  @id @default(cuid())
  slug        String
  name        String
  fullName    String
  description String? @db.Text
  language    String?
  isPrivate   Boolean @default(true)
  defaultBranch String @default("main")
  workspaceId String

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files        RepoFile[]
  commits      RepoCommit[]
  pullRequests RepoPullRequest[]
  branches     RepoBranch[]

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, slug])
  @@map("repositories")
}

model RepoFile {
  id           String  @id @default(cuid())
  repositoryId String
  path         String
  name         String
  type         String  // "file" | "directory"
  size         Int?
  content      String? @db.Text
  language     String?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  lastSyncedAt DateTime @default(now())

  @@unique([repositoryId, path])
  @@index([repositoryId])
  @@map("repo_files")
}

model RepoCommit {
  id           String   @id @default(cuid())
  repositoryId String
  hash         String
  message      String   @db.Text
  authorName   String
  authorEmail  String?
  filesChanged String?  @db.Text // comma-separated file paths
  date         DateTime

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, hash])
  @@index([repositoryId])
  @@map("repo_commits")
}

model RepoPullRequest {
  id           String  @id @default(cuid())
  repositoryId String
  prNumber     Int
  title        String
  description  String? @db.Text
  state        String  // "OPEN", "MERGED", "DECLINED", "SUPERSEDED"
  authorName   String
  sourceBranch String
  targetBranch String
  filesChanged Int     @default(0)
  createdDate  DateTime
  updatedDate  DateTime

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, prNumber])
  @@index([repositoryId])
  @@map("repo_pull_requests")
}

model RepoBranch {
  id           String @id @default(cuid())
  repositoryId String
  name         String
  commitHash   String?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@index([repositoryId])
  @@map("repo_branches")
}

// ─── Chat ───────────────────────────────────────────────

model ChatFolder {
  id     String @id @default(cuid())
  userId String
  name   String

  sessions ChatSession[]
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("chat_folders")
}

model ChatSession {
  id     String @id @default(cuid())
  userId String
  title  String @default("Yeni Sohbet")

  // Optional: chat can be scoped to a repo
  repositorySlug  String?
  workspaceSlug   String?

  // Optional folder
  folderId String?
  folder   ChatFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  messages ChatMessage[]
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String @id @default(cuid())
  chatSessionId String
  role          String // "user" | "assistant" | "system"
  content       String @db.Text

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([chatSessionId])
  @@map("chat_messages")
}
